# Postgres (baza separata, ex. mydashboard pe serverul Hetzner)
DATABASE_URL="postgresql://user:parola@host:5432/mydashboard"

# NextAuth:  npx auth secret   (sau orice sir aleator lung)
AUTH_SECRET=""
AUTH_URL="https://mydashboard.ro"

# Cheia cu care se cripteaza token-urile Stripe/Meta/etc. in baza de date.
# NU o schimba dupa ce ai conectat conturi (nu se mai pot decripta).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Secret pentru /api/cron/sync (acelasi si in GitHub secret CRON_SECRET)
CRON_SECRET=""

# Optional
META_API_VERSION="v23.0"

# PostingClips (clipuri postate + vizualizari). Implicit https://postingclips.com
POSTINGCLIPS_URL=""

# Statistici din aplicatii (README → „Statistici din aplicații”). Implicit https://<domeniul proiectului>.
# Doar pentru teste locale: proiect=adresa, separate prin virgula, ex. "bazadate=http://localhost:3000"
APP_STATS_URLS=""

# E-mailuri (alerte + raportul de dimineata) prin Resend; destinatarul implicit e contact@mydashboard.ro
RESEND_API_KEY=""
ALERT_EMAIL=""

# Google Search Console: cheia JSON a robotului (service account), adaugat ca utilizator in Search Console
# pe fiecare proprietate sc-domain:<domeniu>. Una dintre cele doua:
#   - calea spre fisier (local, ex. C:/Users/Eu/.secrets/gsc-key.json)
GSC_SERVICE_ACCOUNT_FILE=""
#   - sau tot fisierul in base64, pe o singura linie (recomandat pe server, merge direct in ENV_CONTENTS):
#       base64 -w0 gsc-key.json
GSC_SERVICE_ACCOUNT_JSON=""

# Explicatia pe intelesul tau a alertelor necunoscute (Claude Haiku 4.5). Fara cheie: doar regulile fixe.
# Cheie API obisnuita (sk-ant-...), NU cheia de administrare de la Costuri AI. Cel mult ALERT_AI_MAX_PER_HOUR apeluri pe ora (implicit 10; 0 = oprit).
ANTHROPIC_API_KEY=
ALERT_AI_MAX_PER_HOUR=10

# Inboxul E-mail al aplicatiilor (/dashboard/email). O casuta pe aplicatie, contact@<domeniu> pe mail.<domeniu>
# (IMAP 993 doar citire, SMTP 465 pentru raspunsuri; raspunsul pleaca din aceeasi casuta, copia in INBOX.Sent).
# Un singur rand JSON; parolele DOAR in .env (local / server), niciodata in git. Casutele necesare:
#   contact@ai365.ro, contact@anexa1.ro, contact@bazadate.ro, contact@beneficiari.ro, contact@invitonline.ro,
#   contact@oferte.net, contact@postingclips.com, contact@tiparementale.ro, contact@mydashboard.ro
#   (constelatii.com: se adauga la fel cand exista casuta). Platformele 3D NU intra aici (au panoul lor).
# Optional pe casuta: "project" (cheia aplicatiei, implicit dupa domeniu), "tlsInsecure": true (certificat invalid).
MAILBOXES_JSON='[{"label":"bazadate","address":"contact@bazadate.ro","imapHost":"mail.bazadate.ro","imapPort":993,"smtpHost":"mail.bazadate.ro","smtpPort":465,"user":"contact@bazadate.ro","pass":"PAROLA","folders":["INBOX","INBOX.Sent"],"sentFolder":"INBOX.Sent"}]'
# Optional: EMAIL_FIRST_SYNC_DAYS=30  EMAIL_SYNC_BATCH=60  EMAIL_MAX_MESSAGE_MB=30

# Robotul-operator (Telegram): cheia pentru /api/operator/* (doar citire). Fara ea (sau sub 32 de caractere) API-ul e oprit.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPERATOR_TOKEN=""
