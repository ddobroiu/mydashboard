# Postgres (baza separata, ex. mydashboard pe serverul Hetzner)
DATABASE_URL="postgresql://user:parola@host:5432/mydashboard"

# NextAuth:  npx auth secret   (sau orice sir aleator lung)
AUTH_SECRET=""
AUTH_URL="https://mydashboard.ro"

# Cheia cu care se cripteaza token-urile Stripe/Meta/etc. in baza de date.
# NU o schimba dupa ce ai conectat conturi (nu se mai pot decripta).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Secret pentru /api/cron/sync (acelasi si in GitHub secret CRON_SECRET)
CRON_SECRET=""

# Optional
META_API_VERSION="v23.0"

# PostingClips (clipuri postate + vizualizari). Implicit https://postingclips.com
POSTINGCLIPS_URL=""

# Statistici din aplicatii (README → „Statistici din aplicații”). Implicit https://<domeniul proiectului>.
# Doar pentru teste locale: proiect=adresa, separate prin virgula, ex. "bazadate=http://localhost:3000"
APP_STATS_URLS=""

# E-mailuri (alerte + raportul de dimineata) prin Resend; destinatarul implicit e contact@mydashboard.ro
RESEND_API_KEY=""
ALERT_EMAIL=""

# Google Search Console: cheia JSON a robotului (service account), adaugat ca utilizator in Search Console
# pe fiecare proprietate sc-domain:<domeniu>. Una dintre cele doua:
#   - calea spre fisier (local, ex. C:/Users/Eu/.secrets/gsc-key.json)
GSC_SERVICE_ACCOUNT_FILE=""
#   - sau tot fisierul in base64, pe o singura linie (recomandat pe server, merge direct in ENV_CONTENTS):
#       base64 -w0 gsc-key.json
GSC_SERVICE_ACCOUNT_JSON=""
